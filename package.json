{
  "name": "grok-bot-fifo",
  "version": "0.1.0",
  "description": "Grok Bot FIFO: Cloudflare Worker + D1 queue authority + fifo CLI, with webhook hooks for Grok Bot agent routines",
  "type": "module",
  "bin": {
    "fifo": "./cli/fifo.mjs"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts",
    "fifo": "node ./cli/fifo.mjs",
    "d1:local": "wrangler d1 migrations apply fifo-worker --local"
  },
  "keywords": [
    "cloudflare-worker",
    "fifo",
    "d1"
  ],
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260819.1",
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "wrangler": "^4.124.0"
  },
  "dependencies": {
    "jose": "^5.10.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bradmb/grok-bot-fifo.git"
  }
}
